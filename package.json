{
  "name": "tsograph",
  "version": "0.7.0",
  "description": "Static HTTP server/client and persistence facts for TypeScript/JavaScript, with call-graph traversal for the isthmus exchange.",
  "keywords": [
    "openapi",
    "static-analysis",
    "http",
    "routes",
    "nextjs",
    "hono",
    "express",
    "fastify",
    "koa",
    "nestjs",
    "prisma",
    "sql",
    "call-graph",
    "isthmus"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ictechgy/tsograph.git"
  },
  "bugs": {
    "url": "https://github.com/ictechgy/tsograph/issues"
  },
  "homepage": "https://github.com/ictechgy/tsograph#readme",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "tsograph": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "README.ko.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "verify:build": "node scripts/verify-build-contract.mjs",
    "verify:cli": "npm run verify:build && node scripts/verify-cli-contract.mjs",
    "verify": "npm run typecheck && npm test && npm run verify:build && node scripts/verify-cli-contract.mjs",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "axios": "1.20.0",
    "ky": "2.1.0",
    "ky-v1": "npm:ky@1.10.0"
  },
  "dependencies": {
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
